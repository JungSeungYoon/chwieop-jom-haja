# Supabase 프로젝트 생성 후 Settings > API에서 확인합니다.
# 실제 값은 .env에만 작성합니다. 서버 전용 키를 브라우저로 보내지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용: 이미지 검증·변환에만 사용. NEXT_PUBLIC_ 접두사 금지.
SUPABASE_SECRET_KEY=
# 명시적인 데모 모드 기본값. ?demo=1 / ?demo=0으로 화면에서 선택 가능.
NEXT_PUBLIC_DEMO_MODE=false
